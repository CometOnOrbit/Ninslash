"appbuild"
{
    "appid" "1812700"
    "desc" "Ninslash @VERSION@ @GIT_COMMIT@"
    "buildoutput" "@BUILD_OUTPUT@"
    "contentroot" "@CONTENT_ROOT@"
    "setlive" ""
    "preview" "0"
    "depots"
    {
        "@WINDOWS_CLIENT_DEPOT_ID@" "depot_windows_client.vdf"
        "@LINUX_CLIENT_DEPOT_ID@" "depot_linux_client.vdf"
    }
}
